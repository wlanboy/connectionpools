# Gemeinsame Einstellungen für alle .sh-Skripte.
# Werte aus der Umgebung haben Vorrang, z. B. DB_HOST=10.0.0.5 ./install.sh

# Wo die MySQL-DB läuft
DB_HOST=${DB_HOST:-192.168.178.91}
DB_PORT=${DB_PORT:-3306}

# Image-Registry: localhost:5001 (kind) oder registry.gmk.lan
REGISTRY=${REGISTRY:-registry.gmk.lan}
